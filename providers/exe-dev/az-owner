#!/usr/bin/env python3
"""Run Azure CLI as the dedicated exe.dev Azure Owner service principal.

The private key + certificate PEM lives in GNOME Secret Service under:
  app=theseus, credential=azure-exe-operator

For each invocation this wrapper:
1. reads the PEM into process memory;
2. writes it only under /run/user/1000;
3. uses a temporary AZURE_CONFIG_DIR under the same tmpfs;
4. signs in with certificate-based service-principal auth;
5. runs the requested az command;
6. removes the temporary PEM and Azure CLI cache on exit.
"""

from __future__ import annotations

import os
from pathlib import Path
import subprocess
import sys
import tempfile

APP_ID = "9d03ca4c-53e1-4b57-9acf-728d4985457d"
TENANT_ID = "673ee0ec-b9c2-48e3-86c9-0737bd2e99a9"
SUBSCRIPTION_ID = "d760fa4b-978b-4b6d-a62e-93b55bc36746"

RUNTIME_ROOT = Path("/run/user/1000")
SECRET_TOOL = "/usr/bin/secret-tool"
AZ = "/usr/bin/az"


def _base_env() -> dict[str, str]:
    env = os.environ.copy()
    env["XDG_RUNTIME_DIR"] = str(RUNTIME_ROOT)
    env["DBUS_SESSION_BUS_ADDRESS"] = f"unix:path={RUNTIME_ROOT}/bus"
    env["AZURE_CORE_COLLECT_TELEMETRY"] = "no"
    return env


def main(argv: list[str]) -> int:
    if not argv:
        print("usage: az-owner <az arguments...>", file=sys.stderr)
        return 2

    env = _base_env()

    try:
        result = subprocess.run(
            [
                SECRET_TOOL,
                "lookup",
                "app",
                "theseus",
                "credential",
                "azure-exe-operator",
            ],
            env=env,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=True,
        )
    except subprocess.CalledProcessError:
        print("az-owner: Azure operator credential lookup failed", file=sys.stderr)
        return 1

    pem_bytes = result.stdout
    if b"BEGIN PRIVATE KEY" not in pem_bytes or b"BEGIN CERTIFICATE" not in pem_bytes:
        print("az-owner: Azure operator credential is incomplete", file=sys.stderr)
        return 1

    with tempfile.TemporaryDirectory(prefix="theseus-azure-owner-", dir=RUNTIME_ROOT) as td:
        root = Path(td)
        os.chmod(root, 0o700)

        pem = root / "identity.pem"
        pem.write_bytes(pem_bytes)
        os.chmod(pem, 0o600)
        pem_bytes = b""

        azure_config = root / "azure"
        azure_config.mkdir(mode=0o700)
        env["AZURE_CONFIG_DIR"] = str(azure_config)

        login = [
            AZ,
            "login",
            "--service-principal",
            "--username",
            APP_ID,
            "--certificate",
            str(pem),
            "--tenant",
            TENANT_ID,
            "--skip-subscription-discovery",
            "--subscription",
            SUBSCRIPTION_ID,
            "--only-show-errors",
            "-o",
            "none",
        ]

        try:
            subprocess.run(
                login,
                env=env,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.PIPE,
                check=True,
            )
        except subprocess.CalledProcessError:
            print("az-owner: Azure service-principal login failed", file=sys.stderr)
            return 1

        completed = subprocess.run([AZ, *argv], env=env)
        return completed.returncode


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
